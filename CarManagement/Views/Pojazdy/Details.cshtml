@model CarManagementApp.Models.ViewModels.PojazdDetailsViewModel
@{
    ViewData["Title"] = "Pojazd " + Model.Pojazd.NumerRejestracyjny;
}
<h2>Pojazd @Model.Pojazd.NumerRejestracyjny</h2>

<div class="mb-3">
    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@Model.Pojazd.Id">Edytuj</a>
    <a class="btn btn-sm btn-secondary" asp-action="Index">Lista</a>
</div>

<div class="row">
    <div class="col-md-4">
        <h5>Dane podstawowe</h5>
        <ul class="list-unstyled">
            <li><strong>Marka/Model:</strong> @Model.Pojazd.Marka @Model.Pojazd.Model</li>
            <li><strong>Rok:</strong> @Model.Pojazd.Rok</li>
            <li><strong>VIN:</strong> @Model.Pojazd.VIN</li>
            <li><strong>Napêd:</strong> @Model.Pojazd.TypNapedu</li>
            <li><strong>Status:</strong> @Model.Pojazd.Status</li>
            <li><strong>Przebieg (ostatni zapis):</strong> @Model.Pojazd.PrzebiegKm km</li>
            <li><strong>Kategoria:</strong> @Model.Pojazd.Kategoria?.Nazwa</li>
        </ul>
        @if (Model.SrednieSpalanieL100 != null)
        {
            <p><strong>Œrednie spalanie:</strong> @Model.SrednieSpalanieL100 L/100km</p>
        }
    </div>
    <div class="col-md-8">
        <h5>Aktywne polisy</h5>
        <table class="table table-sm">
            <thead>
                <tr><th>Typ</th><th>Numer</th><th>Od</th><th>Do</th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model.PolisyAktywne)
            {
                <tr>
                    <td>@p.Typ</td>
                    <td>@p.Numer</td>
                    <td>@p.DataOd.ToString("yyyy-MM-dd")</td>
                    <td>@p.DataDo.ToString("yyyy-MM-dd")</td>
                </tr>
            }
            </tbody>
        </table>

        <h5>Ostatnie serwisy</h5>
        <table class="table table-sm">
            <thead><tr><th>Data</th><th>Rodzaj</th><th>Przebieg</th><th>Koszt</th></tr></thead>
            <tbody>
            @foreach (var s in Model.OstatnieSerwisy)
            {
                <tr>
                    <td>@s.Data.ToString("yyyy-MM-dd")</td>
                    <td>@s.Rodzaj</td>
                    <td>@s.PrzebiegKm</td>
                    <td>@s.Koszt?.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>

        <h5>Historia przypisañ</h5>
        <table class="table table-sm">
            <thead><tr><th>Kierowca</th><th>Od</th><th>Do</th><th>Tryb</th></tr></thead>
            <tbody>
            @foreach (var a in Model.HistoriaPrzypisan)
            {
                <tr>
                    <td>@a.Kierowca.Imie @a.Kierowca.Nazwisko</td>
                    <td>@a.DataOd.ToString("yyyy-MM-dd")</td>
                    <td>@(a.DataDo?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>@a.TrybUzytkowania</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>